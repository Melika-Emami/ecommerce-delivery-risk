# uv virtual environment
.venv/

# Python and Jupyter caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Local environment variables
.env
.env.*
!.env.example

# Downloaded data and generated model files
/data/raw/*
!/data/raw/.gitkeep

/data/processed/*
!/data/processed/.gitkeep

/models/*
!/models/.gitkeep